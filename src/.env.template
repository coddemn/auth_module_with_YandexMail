# DSN для приложения (работает внутри docker-сети, хост = имя сервиса db)
APP_CONFIG__DB__URL=postgresql+asyncpg://user:pass@db:port/name_db
APP_CONFIG__DB__ECHO=0

# DSN для Alembic, когда миграции запускаются С ХОСТА через venv (порт проброшен как 5433)
APP_CONFIG__DB__URL_MIGRATIONS=postgresql+asyncpg://user:pass@host:port/name_db

# Секреты (сгенерируй свои, например openssl rand -hex 32)
APP_CONFIG__SECRETS__JWT_SECRET_KEY="replace_with_random_secret"
APP_CONFIG__SECRETS__TEMP_JWT_SECRET_KEY="replace_with_another_random_secret"

# Почта для рассылки (для Яндекса — пароль приложения, не пароль от аккаунта)
APP_CONFIG__SECRETS__LOGIN_MAIL=""
APP_CONFIG__SECRETS__PASSWORD_MAIL=""